# Demo is the safe default and keeps using the checked-in synthetic fixtures.
RPO_DATA_MODE=demo

# Production MongoDB mode. Use a secret manager in deployment; never commit values.
# RPO_DATA_MODE=mongodb
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=reserve_pay_optimizer
# RPO_INGEST_API_KEY=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API.
RPO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
